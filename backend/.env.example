# Gemini LLM & Embedding Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_jd_gap

# Application Settings
ENVIRONMENT=development
PORT=8000

# RAG Knowledge Base & Retrieval Settings (Optional)
KNOWLEDGE_BASE_DIR=data/knowledge
VECTOR_STORE_PATH=data/vector_store.json
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SIMILARITY=0.40
MAX_RECOMMENDATIONS=6
