# Groq LLM Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Embedding Configuration (Optional Gemini embeddings)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_jd_gap

# Application Settings
ENVIRONMENT=development
PORT=8000

# RAG Knowledge Base & Retrieval Settings (Optional)
KNOWLEDGE_BASE_DIR=data/knowledge
VECTOR_STORE_PATH=data/vector_store.json
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SIMILARITY=0.40
MAX_RECOMMENDATIONS=6
